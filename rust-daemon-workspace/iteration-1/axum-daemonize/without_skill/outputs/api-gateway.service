[Unit]
Description=API Gateway — axum-based HTTP service
Documentation=https://example.com/api-gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=notify

# Run as a dedicated service user (create with: useradd --system --no-create-home api-gateway)
User=api-gateway
Group=api-gateway

# Binary and config
ExecStart=/usr/local/bin/api-gateway /etc/api-gateway/config.toml
ExecReload=/bin/kill -HUP $MAINPID

# Watchdog: systemd will send SIGABRT if the daemon fails to ping within 30s.
WatchdogSec=30

# Restart policy
Restart=on-failure
RestartSec=5

# Graceful shutdown: give the daemon time to drain in-flight requests.
# This should be >= the shutdown_timeout_secs in config.toml.
TimeoutStopSec=45

# PID file (matches config.toml default)
PIDFile=/run/api-gateway/api-gateway.pid
RuntimeDirectory=api-gateway
RuntimeDirectoryMode=0755

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=api-gateway

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
