[Unit]
Description=API Gateway Service
Documentation=https://github.com/your-org/api-gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=notify

# Binary and config path
ExecStart=/usr/local/bin/api-gateway --config /etc/api-gateway/config.toml

# SIGHUP triggers config reload (handled by the signal listener)
ExecReload=/bin/kill -HUP $MAINPID

# Restart policy
Restart=on-failure
RestartSec=5s

# Watchdog: the daemon must ping systemd within this interval or
# it will be considered hung and restarted. The daemon pings every
# watchdog_interval_secs (default 10s), so 30s gives a 3x safety margin.
WatchdogSec=30s

# Give in-flight requests time to drain before SIGKILL.
# Should be >= shutdown_timeout_secs in config.toml.
TimeoutStopSec=35s

# ── Security hardening ──────────────────────────────────────────
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
ReadWritePaths=/var/lib/api-gateway /run/api-gateway

# ── Resource limits ─────────────────────────────────────────────
LimitNOFILE=65536
MemoryMax=512M

# ── Runtime directories (systemd creates these automatically) ───
# /run/api-gateway — for PID file and sockets (tmpfs, cleared on reboot)
RuntimeDirectory=api-gateway
# /var/lib/api-gateway — for persistent state
StateDirectory=api-gateway

# ── Logging ─────────────────────────────────────────────────────
StandardOutput=journal
StandardError=journal
SyslogIdentifier=api-gateway

[Install]
WantedBy=multi-user.target
