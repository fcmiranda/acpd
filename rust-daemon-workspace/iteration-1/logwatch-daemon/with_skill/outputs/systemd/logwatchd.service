[Unit]
Description=Log Watch Daemon - Monitors log directories for error patterns
Documentation=https://github.com/user/logwatchd
After=network-online.target dbus.service
Wants=network-online.target
Requires=dbus.service

[Service]
Type=notify
ExecStart=/usr/local/bin/logwatchd --config /etc/logwatchd/config.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
WatchdogSec=60s

# User and group — run as a dedicated service user
# Uncomment and adjust after creating the logwatchd user:
# User=logwatchd
# Group=logwatchd

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

# Grant read access to the watched log directory and daemon state
ReadOnlyPaths=/var/log
ReadWritePaths=/run/logwatchd

# Resource limits
LimitNOFILE=65536
MemoryMax=256M

# Runtime and state directories (systemd creates these automatically)
RuntimeDirectory=logwatchd
StateDirectory=logwatchd
ConfigurationDirectory=logwatchd

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=logwatchd

# Environment — allow access to D-Bus for desktop notifications
# When running as a system service, you may need to configure D-Bus
# access or run as the desktop user's service instead.
# For user-level service, use: systemctl --user enable logwatchd
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus

[Install]
WantedBy=multi-user.target
