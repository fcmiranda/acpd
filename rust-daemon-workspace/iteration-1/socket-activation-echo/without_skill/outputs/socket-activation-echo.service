[Unit]
Description=Socket-Activated TCP Echo Daemon
Documentation=man:systemd.service(5)
After=network.target
Requires=socket-activation-echo.socket

[Service]
Type=simple
ExecStart=/usr/local/bin/socket-activation-echo
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=socket-activation-echo

[Install]
WantedBy=multi-user.target
