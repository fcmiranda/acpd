[Unit]
Description=ACPD: Agent Client Protocol Daemon
Documentation=https://github.com/user/acpd
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/acpd --config /etc/acpd/config.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths=/run/acpd

# Resource limits
LimitNOFILE=65536
MemoryMax=512M

# Runtime directory for PID file and sockets
RuntimeDirectory=acpd

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=acpd

[Install]
WantedBy=multi-user.target
