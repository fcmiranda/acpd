[Unit]
Description=ACPD: Agent Client Protocol Daemon
Documentation=https://github.com/user/acpd
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
# Apontamos diretamente para o binário do repositório para facilitar o desenvolvimento
ExecStart=/home/fecavmi/dev/github/acpd/target/release/acpd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Security hardening (Relaxado para rodar na pasta do usuário)
NoNewPrivileges=yes
# Resource limits
LimitNOFILE=65536
MemoryMax=512M

# Runtime directory for PID file and sockets
RuntimeDirectory=acpd

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=acpd

[Install]
WantedBy=default.target
